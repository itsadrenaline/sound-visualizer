{
  "name": "sound-visualizer",
  "productName": "Sound Visualizer",
  "version": "1.8.3",
  "description": "A learning project: a 3D visualizer that follows your SoundSwitch rig and show over Art-Net.",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "setup": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "build:web": "vite build --config vite.web.config.ts",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "artnet:test": "node scripts/artnet-test.mjs",
    "library": "node scripts/build-library.mjs",
    "dist": "node scripts/dist-mac.mjs",
    "check": "tsc --noEmit && vitest run",
    "dist:mac": "node scripts/dist-mac.mjs",
    "verify:mac": "node scripts/dist-mac.mjs --verify-only",
    "bridge": "esbuild src/bridge/index.ts --bundle --platform=node --format=esm --outfile=out/bridge/bridge.mjs --log-level=warning && node out/bridge/bridge.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "fflate": "0.8.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "zustand": "5.1.0"
  },
  "author": "Sound Visualizer contributors",
  "license": "GPL-3.0-or-later",
  "homepage": "https://open-fixture-library.org"
}
