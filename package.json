{
  "name": "sound-visualizer",
  "productName": "Sound Visualizer",
  "version": "1.6.0",
  "description": "A learning project: a 3D visualizer that follows your SoundSwitch rig and show over Art-Net.",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "setup": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "artnet:test": "node scripts/artnet-test.mjs",
    "library": "node scripts/build-library.mjs",
    "dist": "node scripts/dist-mac.mjs",
    "check": "tsc --noEmit && vitest run",
    "dist:mac": "node scripts/dist-mac.mjs",
    "verify:mac": "node scripts/dist-mac.mjs --verify-only"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "fflate": "^0.8.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11",
    "zustand": "5.0.15"
  },
